{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BZ Hub",
  "version": "0.1.0",
  "identifier": "com.bzhub.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BZ Hub",
        "width": 720,
        "height": 760,
        "minWidth": 580,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.qweatherapi.com https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A cross-platform launcher for apps, projects and websites",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
